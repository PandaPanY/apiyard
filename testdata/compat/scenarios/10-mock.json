      }
    },
    {
      "name": "Mock 规则（形状）",
      "method": "GET",
      "path": "/mock/{{pid}}/api/users",
      "shape": true,
      "responseHeaders": [
        "Content-Type"
      ]
    },
    {
      "name": "路径参数和查询参数",
      "method": "GET",
      "path": "/mock/{{pid}}/api/users/42",
      "query": {
        "q": "搜索"
      }
    },
    {
      "name": "请求体变量（JSON5 模板）",
      "method": "POST",
      "path": "/mock/{{pid}}/api/users",
      "body": {
        "name": "tom",
        "tags": [
          "a",
          "b"
        ]
      }
    },
    {
      "name": "纯文本不处理占位符",
      "method": "GET",
      "path": "/mock/{{pid}}/api/plain",
      "responseHeaders": [
        "Content-Type"
      ]
    },
    {
      "name": "以 < 开头为 HTML",
      "method": "GET",
      "path": "/mock/{{pid}}/api/html",
      "responseHeaders": [
        "Content-Type"
      ]
    },
    {
      "name": "空响应体",
      "method": "GET",
      "path": "/mock/{{pid}}/api/empty",
      "responseHeaders": [
        "Content-Type"
      ]
    },
    {
      "name": "数字",
      "method": "GET",
      "path": "/mock/{{pid}}/api/number",
      "responseHeaders": [
        "Content-Type"
      ]
    },
    {
      "name": "null 返回 204",
      "method": "GET",
      "path": "/mock/{{pid}}/api/null"
    },
    {
      "name": "不是 JSON 的模板按字符串处理",
      "method": "GET",
      "path": "/mock/{{pid}}/api/text",
      "responseHeaders": [
