      "method": "GET",
      "path": "/mock/{{pid}}/api/search",
      "query": {
        "type": "1"
      }
    },
    {
      "name": "query_path：只看最后一个参数",
      "method": "GET",
      "path": "/mock/{{pid}}/api/search",
      "query": {
        "type": "9",
        "page": "1"
      }
    },
    {
      "name": "query_path：都不匹配",
      "method": "GET",
      "path": "/mock/{{pid}}/api/search",
      "query": {
        "type": "3"
      },
      "errcode": 404
    },
    {
      "name": "段内的 {name}",
      "method": "GET",
      "path": "/mock/{{pid}}/api/files/report.json"
    },
    {
      "name": "冒号参数",
      "method": "GET",
      "path": "/mock/{{pid}}/api/orders/A01/items"
    },
    {
      "name": "段数不同",
      "method": "GET",
      "path": "/mock/{{pid}}/api/orders/A01",
      "errcode": 404
    },
    {
      "name": "方法不对",
      "method": "POST",
      "path": "/mock/{{pid}}/api/plain",
      "errcode": 404
    },
    {
      "name": "不存在的接口",
      "method": "GET",
      "path": "/mock/{{pid}}/api/nope",
      "errcode": 404
    },
    {
      "name": "基础路径只按长度截掉",
      "method": "GET",
      "path": "/mock/{{pid}}/xyz/plain"
    },
    {
      "name": "路径编码",
      "method": "GET",
      "path": "/mock/{{pid}}/api/users/%E4%B8%AD"
    },
    {
      "name": "项目 ID 不是数字",
      "method": "GET",
      "path": "/mock/abc/x",
      "errcode": 403
    },
    {
      "name": "项目不存在",
      "method": "GET",
      "path": "/mock/987654/x",
      "errcode": 403
    },
    {
      "name": "项目 ID 是小数",
      "method": "GET",
      "path": "/mock/1.5/x",
      "errcode": 403
    },
    {
      "name": "没有项目 ID",
      "method": "GET",
      "path": "/mock/",
      "errcode": 400
    },
    {
      "name": "Mock.js 出错时返回原模板",
      "method": "GET",
      "path": "/mock/{{pid}}/api/broken"
    },
    {
      "name": "变量取不到时报解析出错",
      "method": "POST",
      "path": "/mock/{{pid}}/api/bad-var",
      "body": {
        "x": 5
      },
      "errcode": 400
    },
    {
      "name": "urlencoded 表单",
      "method": "POST",
      "path": "/mock/{{pid}}/api/form",
      "rawBody": "a=1&a=2&f=%E4%B8%AD+x",
      "contentType": "application/x-www-form-urlencoded"
    },
    {
      "name": "multipart：请求体换成 fields",
      "method": "POST",
      "path": "/mock/{{pid}}/api/form",
      "rawBody": "--XBOUNDARY\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nva\r\n--XBOUNDARY\r\nContent-Disposition: form-data; name=\"f\"; filename=\"t.txt\"\r\nContent-Type: text/plain\r\n\r\nfile content\r\n--XBOUNDARY--\r\n",
      "contentType": "multipart/form-data; boundary=XBOUNDARY"
    },
    {
      "name": "纯文本请求体",
      "method": "POST",
      "path": "/mock/{{pid}}/api/form",
      "rawBody": "hello",
      "contentType": "text/plain",
      "errcode": 400
    },
    {
      "name": "带 Origin 的请求",
      "method": "GET",
      "path": "/mock/{{pid}}/api/plain",
      "headers": {
        "Origin": "http://example.com"
      },
      "responseHeaders": [
        "Access-Control-Allow-Origin",
        "Access-Control-Allow-Credentials"
      ]
    },
    {
      "name": "跨域预检",
      "method": "OPTIONS",
      "path": "/mock/{{pid}}/api/plain",
      "headers": {
        "Origin": "http://example.com",
        "Access-Control-Request-Method": "POST",
        "Access-Control-Request-Headers": "x-token"
      },
      "responseHeaders": [
        "Access-Control-Allow-Origin",
        "Access-Control-Allow-Methods",
        "Access-Control-Allow-Headers",
        "Access-Control-Max-Age",
        "Content-Type"
      ]
    },
    {
      "name": "不是预检的 OPTIONS",
      "method": "OPTIONS",
      "path": "/mock/{{pid}}/api/plain",
      "errcode": 404
    },
    {
      "name": "开启严格模式",
      "method": "POST",
      "path": "/api/project/up",
      "body": {
        "id": "{{pid}}",
        "strice": true
      }
    },
    {
      "name": "新建接口：严格：查询参数",
      "method": "POST",
      "path": "/api/interface/add",
      "body": {
        "project_id": "{{pid}}",
        "catid": "{{cat}}",
        "title": "严格：查询参数",
        "path": "/strict/query",
        "method": "GET",
        "req_headers": [],
        "req_body_form": [],
        "req_query": [
          {
            "name": "page",
            "required": "1"
          },
          {
            "name": "size",
            "required": "1"
          },
          {
            "name": "opt",
            "required": "0"
          }
        ],
        "res_body_type": "json",
        "res_body": "{\"ok\": true}"
      },
      "capture": {
        "s1": "data._id"
      }
    },
    {
      "name": "新建接口：严格：表单",
      "method": "POST",
      "path": "/api/interface/add",
      "body": {
        "project_id": "{{pid}}",
        "catid": "{{cat}}",
        "title": "严格：表单",
        "path": "/strict/form",
        "method": "POST",
        "req_headers": [],
        "req_body_form": [
          {
            "name": "a",
            "type": "text",
            "required": "1"
          },
          {
            "name": "file",
            "type": "file",
            "required": "1"
          }
        ],
        "req_body_type": "form",
        "res_body_type": "json",
        "res_body": "{\"ok\": true}"
      },
      "capture": {
        "s2": "data._id"
      }
    },
    {
      "name": "新建接口：严格：JSON Schema",
      "method": "POST",
      "path": "/api/interface/add",
      "body": {
        "project_id": "{{pid}}",
        "catid": "{{cat}}",
        "title": "严格：JSON Schema",
        "path": "/strict/json",
        "method": "POST",
        "req_headers": [],
        "req_body_form": [],
        "req_body_type": "json",
        "req_body_is_json_schema": true,
        "req_body_other": "{\"type\": \"object\", \"required\": [\"name\", \"age\"], \"properties\": {\"name\": {\"type\": \"string\", \"minLength\": 2}, \"age\": {\"type\": \"integer\", \"minimum\": 1}, \"tags\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}}}",
        "res_body_type": "json",
        "res_body": "{\"ok\": true}"
      },
      "capture": {
        "s3": "data._id"
      }
    },
