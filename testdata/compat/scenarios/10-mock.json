    {
      "name": "multipart 表单齐全",
      "method": "POST",
      "path": "/mock/{{pid}}/api/strict/form",
      "rawBody": "--XBOUNDARY\r\nContent-Disposition: form-data; name=\"a\"\r\n\r\nva\r\n--XBOUNDARY\r\nContent-Disposition: form-data; name=\"file\"; filename=\"t.txt\"\r\nContent-Type: text/plain\r\n\r\nfile content\r\n--XBOUNDARY--\r\n",
      "contentType": "multipart/form-data; boundary=XBOUNDARY"
    },
    {
      "name": "JSON 缺少必需属性",
      "method": "POST",
      "path": "/mock/{{pid}}/api/strict/json",
      "body": {
        "name": "tom"
      },
      "errcode": 404
    },
