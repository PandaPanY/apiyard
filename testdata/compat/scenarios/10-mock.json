{
  "description": "M5：Mock 服务。地址匹配（完整路径、query_path、路径参数）、Mock.js 规则和占位符、${query.x} 变量、JSON Schema、各种响应类型、跨域、严格模式校验。随机生成的响应只比对形状",
  "steps": [
    {
      "name": "管理员登录",
      "method": "POST",
      "path": "/api/user/login",
      "body": {
        "email": "admin@admin.com",
        "password": "ymfe.org"
      }
    },
    {
      "name": "新建分组",
      "method": "POST",
      "path": "/api/group/add",
      "body": {
        "group_name": "Mock 组",
        "owner_uids": []
      },
      "capture": {
        "gid": "data._id"
      }
    },
    {
      "name": "新建项目",
      "method": "POST",
      "path": "/api/project/add",
      "body": {
        "name": "Mock 项目",
        "basepath": "/api",
        "group_id": "{{gid}}",
        "desc": "Mock 测试"
      },
      "capture": {
        "pid": "data._id"
      }
    },
    {
      "name": "默认分类",
      "method": "GET",
      "path": "/api/project/get",
      "query": {
        "id": "{{pid}}"
      },
      "capture": {
        "cat": "data.cat.0._id"
      }
    },
    {
      "name": "新建接口：用户列表",
      "method": "POST",
      "path": "/api/interface/add",
      "body": {
        "project_id": "{{pid}}",
        "catid": "{{cat}}",
        "title": "用户列表",
        "path": "/users",
        "method": "GET",
        "req_headers": [],
        "req_body_form": [],
        "res_body_type": "json",
        "res_body": "{\"code\": 0, \"data|2-4\": [{\"id|+1\": 1, \"name\": \"@cname\", \"email\": \"@email\", \"age|18-60\": 1, \"active|1\": true, \"created\": \"@datetime\", \"tags|1-3\": [\"@word\"], \"score|1-100.1-2\": 1, \"city\": \"@city(true)\", \"ip\": \"@ip\", \"guid\": \"@guid\", \"color\": \"@color\", \"url\": \"@url\"}], \"phone|regexp\": \"1[3-9]\\\\d{9}\"}"
      },
      "capture": {
        "i1": "data._id"
      }
    },
    {
      "name": "新建接口：用户详情",
      "method": "POST",
      "path": "/api/interface/add",
      "body": {
        "project_id": "{{pid}}",
        "catid": "{{cat}}",
        "title": "用户详情",
        "path": "/users/{id}",
        "method": "GET",
        "req_headers": [],
        "req_body_form": [],
        "res_body_type": "json",
        "res_body": "{\"id\": \"${query.id}\", \"q\": \"${query.q}\", \"params\": \"${params.id}\", \"none\": \"${query.none}\"}"
      },
      "capture": {
        "i2": "data._id"
      }
    },
    {
      "name": "新建接口：新建用户",
      "method": "POST",
      "path": "/api/interface/add",
      "body": {
        "project_id": "{{pid}}",
        "catid": "{{cat}}",
        "title": "新建用户",
        "path": "/users",
        "method": "POST",
        "req_headers": [],
        "req_body_form": [],
        "req_body_type": "json",
        "res_body_type": "json",
        "res_body": "{name: '${body.name}', // JSON5 注释\n tag: '${body.tags}', all: '${params.name}',}"
      },
      "capture": {
        "i3": "data._id"
      }
    },
    {
      "name": "新建接口：纯文本",
