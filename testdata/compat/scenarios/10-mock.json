        "res_body_type": "json",
        "res_body_is_json_schema": true,
        "res_body": "{\"type\": \"object\", \"required\": [\"id\", \"name\", \"email\", \"ok\", \"list\"], \"properties\": {\"id\": {\"type\": \"integer\", \"minimum\": 1, \"maximum\": 9}, \"name\": {\"type\": \"string\", \"mock\": {\"mock\": \"@cname\"}}, \"email\": {\"type\": \"string\", \"mock\": {\"mock\": \"@email\"}}, \"ok\": {\"type\": \"boolean\"}, \"list\": {\"type\": \"array\", \"minItems\": 2, \"maxItems\": 2, \"items\": {\"type\": \"object\", \"required\": [\"n\"], \"properties\": {\"n\": {\"type\": \"number\", \"mock\": {\"mock\": \"@integer(1, 5)\"}}}}}}}"
      },
      "capture": {
        "i10": "data._id"
      }
    },
