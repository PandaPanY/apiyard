            "description": "ok",
            "schema": {
              "$ref": "#/definitions/a~1b"
            }
          }
        }
      }
    },
    "/missing": {
      "get": {
        "summary": "缺失引用",
        "responses": {
          "200": {
            "description": "ok",
            "schema": {
              "$ref": "#/definitions/Nope"
            }
          }
        }
      }
