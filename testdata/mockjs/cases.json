[
 {
  "name": "数组重复",
  "tpl": {
   "list|1-3": [
    {
     "id|+1": 1,
     "name": "@cname"
    }
   ]
  }
 },
 {
  "name": "数组固定次数",
  "tpl": {
   "list|2": [
    "a",
    "b"
   ]
  }
 },
 {
  "name": "数组取一个",
  "tpl": {
   "m|1": [
    "GET",
    "POST",
    "PUT"
   ]
  }
 },
 {
  "name": "数组按顺序取",
  "tpl": {
   "list|3": [
    {
     "v|+1": [
      "x",
      "y"
     ]
    }
   ]
  }
 },
 {
  "name": "空数组",
  "tpl": {
   "a|1-3": []
  }
 },
 {
  "name": "对象取部分属性",
  "tpl": {
   "obj|2": {
    "a": 1,
    "b": 2,
    "c": 3
   }
  }
 },
 {
  "name": "对象范围",
  "tpl": {
   "obj|1-2": {
    "a": 1,
    "b": 2,
    "c": 3
   }
  }
 },
 {
  "name": "整数范围",
  "tpl": {
   "n|1-100": 1,
   "neg|-10--1": 1,
   "fixed|7": 1
  }
 },
 {
  "name": "小数",
  "tpl": {
   "f|1-100.1-3": 1,
   "g|.2": 1.5,
   "i|1-10.2-4": 0
  }
 },
 {
  "name": "自增",
  "tpl": {
   "list|5": [
    {
     "id|+2": 10
    }
   ]
  }
 },
 {
  "name": "布尔",
  "tpl": {
   "b|1": true,
   "c|1-9": false,
   "d": true
  }
 },
 {
  "name": "字符串重复",
  "tpl": {
   "s|1-5": "★",
   "t|3": "ab",
   "e|2-4": ""
  }
 },
 {
  "name": "基础占位符",
  "tpl": {
   "a": "@boolean",
   "b": "@natural",
   "c": "@natural(1, 10)",
   "d": "@integer",
   "e": "@integer(-5, 5)",
   "f": "@float",
   "g": "@float(1, 10, 2, 3)"
  }
 },
 {
  "name": "字符",
  "tpl": {
   "a": "@character",
   "b": "@character('lower')",
   "c": "@char('abc')",
   "d": "@character('number')"
  }
 },
 {
  "name": "字符串",
  "tpl": {
   "a": "@string",
   "b": "@string(5)",
   "c": "@string('lower', 3)",
   "d": "@string(2, 4)",
   "e": "@string('upper', 1, 3)",
   "f": "@str('number', 6)"
  }
 },
 {
  "name": "range",
  "tpl": {
   "a": "@range(5)",
   "b": "@range(1, 10, 3)",
   "c": "@range(3, 1)"
  }
 },
 {
  "name": "日期",
  "tpl": {
   "a": "@date",
   "b": "@date('yyyy/MM/dd')",
   "c": "@time",
   "d": "@time('H:m')",
   "e": "@datetime",
   "f": "@datetime('yy-M-d h:mm A')",
   "g": "@date('T')"
  }
 },
 {
  "name": "now",
  "tpl": {
   "a": "@now",
   "b": "@now('year')",
   "c": "@now('day', 'yyyy-MM-dd HH:mm')",
   "d": "@now('yyyy')",
   "e": "@now('week', 'yyyy-MM-dd')"
  }
 },
 {
  "name": "图片",
  "tpl": {
   "a": "@image",
   "b": "@image('200x100')",
   "c": "@image('200x100', '#ff0000')",
   "d": "@image('200x100', '#ff0000', 'hello')",
   "e": "@image('200x100', '#ff0000', '#fff', 'png', 'txt')",
   "f": "@img"
  }
 },
 {
  "name": "颜色",
  "tpl": {
   "a": "@color",
   "b": "@hex",
   "c": "@rgb",
   "d": "@rgba",
   "e": "@hsl",
   "f": "@color('red')"
  }
 },
 {
  "name": "英文文本",
  "tpl": {
   "a": "@word",
   "b": "@word(5)",
   "c": "@word(2, 4)",
   "d": "@sentence",
   "e": "@sentence(3)",
   "f": "@title",
   "g": "@title(2)",
   "h": "@paragraph(2)"
  }
 },
 {
  "name": "中文文本",
  "tpl": {
   "a": "@cword",
   "b": "@cword(3)",
   "c": "@cword('零一二三')",
   "d": "@cword('零一二三', 2)",
   "e": "@cword(2, 3)",
   "f": "@csentence",
   "g": "@ctitle",
   "h": "@cparagraph(2)",
   "i": "@csentence(5, 6)"
  }
 },
 {
  "name": "姓名",
  "tpl": {
   "a": "@first",
   "b": "@last",
   "c": "@name",
   "d": "@name(true)",
   "e": "@cfirst",
   "f": "@clast",
   "g": "@cname"
  }
 },
 {
  "name": "网络",
  "tpl": {
   "a": "@url",
   "b": "@url('https')",
   "c": "@url('http', 'example.com')",
   "d": "@protocol",
   "e": "@domain",
   "f": "@domain('com')",
   "g": "@tld",
   "h": "@email",
   "i": "@email('qq.com')",
   "j": "@ip"
  }
 },
 {
  "name": "地址",
  "tpl": {
   "a": "@region",
   "b": "@province",
   "c": "@city",
   "d": "@city(true)",
   "e": "@county",
   "f": "@county(true)",
   "g": "@zip",
   "h": "@zip(4)"
  },
  "skipRange": [
   "$.e",
   "$.f"
  ]
 },
 {
  "name": "辅助",
  "tpl": {
   "a": "@capitalize('hello')",
   "b": "@upper('abc')",
   "c": "@lower('ABC')",
   "d": "@pick(['x', 'y', 'z'])",
   "e": "@pick('x', 'y')",
   "f": "@pick([1, 2, 3], 2)",
   "g": "@shuffle([1, 2, 3])",
   "h": "@shuffle([1, 2, 3], 2)",
   "i": "@pick([1, 2, 3, 4], 1, 3)"
  }
 },
 {
  "name": "杂项",
  "tpl": {
   "a": "@guid",
   "b": "@uuid",
   "c": "@id",
   "d": "@d6",
   "e": "@d100",
   "f": "@timestamp"
  },
  "skipRange": [
   "$.f"
  ]
 },
 {
  "name": "大小写",
  "tpl": {
   "a": "@EMAIL",
   "b": "@Integer(1, 3)",
   "c": "@CNAME"
  }
 },
 {
  "name": "混合文本",
  "tpl": {
   "a": "编号 @integer(1, 9) 号",
   "b": "@first @last",
   "c": "@email, @ip",
   "d": "\\@email",
   "e": "@unknown",
   "f": "@integer(1,3)@integer(4,6)"
  }
 },
 {
  "name": "引用属性",
  "tpl": {
   "first": "@first",
   "full": "@first @last",
   "ref": "@first"
  }
 },
 {
  "name": "引用模板属性",
  "tpl": {
   "msg": "@name",
   "name": "@cname"
  }
 },
 {
  "name": "路径引用",
  "tpl": {
   "user": {
    "name": "@cname",
    "copy": "@../user/name",
    "abs": "@/user/name"
   },
   "top": "@/user/name"
  }
 },
 {
  "name": "参数里的占位符",
  "tpl": {
   "a": "@pick(['@cname', '@email'])",
   "b": "@integer(@natural(1, 3), 9)"
  }
 },
 {
  "name": "参数不是字面量",
  "tpl": {
   "a": "@date(yyyy-MM-dd)",
   "b": "@pick(a, b, c)",
   "c": "@string(lower, 3)"
  }
 },
 {
  "name": "正则",
  "tpl": {
   "a|regexp": "\\d{3}-[a-z]{2,4}",
   "b|regexp": "(a|b|c)x+y?",
   "c|regexp": "[^0-9a-z]{3}",
   "d|2|regexp": "[A-F]",
   "e|regexp": "1[3-9]\\d{9}"
  }
 },
 {
  "name": "请求变量",
  "tpl": {
   "a": "${query.id}",
   "b": "id=${query.id}",
   "c": "${body.name}",
   "d": "${body.nested}",
   "e": "${params.id}",
   "f": "${query.none}",
   "g": "${foo.bar}",
   "h": "${query.tags}"
  }
 },
 {
  "name": "嵌套",
  "tpl": {
   "code": 0,
   "data|2-4": [
    {
     "id|+1": 100,
     "tags|1-2": [
      "@word"
     ],
     "price|10-99.2": 1,
     "ok|1": true,
     "info": {
      "city": "@city",
      "n": "@integer(1, 3)"
     }
    }
   ]
  }
 },
 {
  "name": "数字键",
  "tpl": {
   "2": "@integer(1, 2)",
   "1": "a",
   "b": 1
  }
 },
 {
  "name": "null 和数字",
  "tpl": {
   "a": null,
   "b": 1.5,
   "c": [
    null,
    1,
    "x"
   ]
  }
 },
 {
  "name": "dataImage",
  "tpl": {
   "a": "@dataImage"
  }
 },
 {
  "name": "无效颜色",
  "tpl": {
   "a": "@color('nocolor')"
  }
 },
 {
  "name": "顶层字符串",
  "tpl": "@email"
 },
 {
  "name": "顶层数组",
  "tpl": [
   {
    "a|1-3": "x"
   },
   "@integer(1, 2)"
  ]
 }
]